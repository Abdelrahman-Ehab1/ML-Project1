    "def _find_k_nearest_neighbors(matrix, target , k, similarity_fn ,axis=0 ,get_co_rated_fn =None , sim_cache=None):\n",
    "    \"\"\"\n",
    "    Finds the top k nearest neighbors for a target user or item.\n",
    "\n",
    "    Args:\n",
    "        matrix (pd.DataFrame): Utility matrix\n",
    "        target (int): ID of target user or item\n",
    "        k (int): Number of neighbors to fetch\n",
    "        similarity_fn (function): Function to calculate similarity\n",
    "        axis (int): Axis along which to find neighbors (0 for users, 1 for items)\n",
    "        get_co_rated_fn (function): Function to get co-rated items/users\n",
    "        sim_cache (dict): Cache for storing computed similarities\n",
    "\n",
    "    Returns:\n",
    "        list[tuple[int, float]]: List of (neighbor_id, similarity_score)\n",
    "    \"\"\"\n",
    "    if get_co_rated_fn is None:\n",
    "        get_co_rated_fn = get_co_rated\n",
    "\n",
    "    #if the matrix is precomputed and cached, we can directly fetch the top k neighbors from the cache\n",
    "    #Ai generated\n",
    "    if sim_cache is not None and target in sim_cache.index:\n",
    "        row = sim_cache.loc[target].drop(labels=[target], errors=\"ignore\").dropna()\n",
    "        return list(row.sort_values(ascending=False).head(k).items())\n",
    "    #end of generation\n",
    "    if axis == 0:\n",
    "        #searching users\n",
    "        similares = matrix.index\n",
    "    else:\n",
    "        #searching items\n",
    "        similares = matrix.columns\n",
    "    neighbors=[]\n",
    "    for similar in similares:\n",
    "        if similar == target:\n",
    "            continue\n",
    "\n",
    "        v1,v2 =get_co_rated_fn(matrix ,target , similar, axis=axis)\n",
    "        #ai generated\n",
    "        if len(v1) < 2:\n",
    "            continue\n",
    "        #end of generation\n",
    "        s =similarity_fn(v1,v2)\n",
    "        if s is None or np.isnan(s):\n",
    "            continue\n",
    "        neighbors.append((similar,s))\n",
    "        #the second element is the sort key and reverse 3la4an teb2a descending order\n",
    "    neighbors.sort(key= lambda x: x[1], reverse = True)\n",
    "    return neighbors [:k]\n",
    "    \n",
    "\n",
    "        \n",
    "        \n"
   ]
