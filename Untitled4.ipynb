    "def get_co_rated(matrix, a, b, axis=0):\n",
    "    if axis == 0:\n",
    "        # Compare rows (users). a and b are user IDs.\n",
    "        vec_a = matrix.loc[a]\n",
    "        vec_b = matrix.loc[b]\n",
    "    elif axis == 1:\n",
    "        # Compare columns (items). a and b are movie IDs.\n",
    "        vec_a = matrix[a]\n",
    "        vec_b = matrix[b]\n",
    "    else:\n",
    "        raise ValueError(\"axis must be 0 (users/rows) or 1 (items/columns)\")\n",
    "\n",
    "    mask = vec_a.notna() & vec_b.notna()\n",
    "\n",
    "    # Apply mask and convert to NumPy arrays\n",
    "    return vec_a[mask].to_numpy(), vec_b[mask].to_numpy()\n",
    "\n",
    "def euclidean_similarity(vec1, vec2):\n",
    "    if len(vec1) < 2:\n",
    "        return np.nan\n",
    "    d = np.sqrt(np.sum((vec1 - vec2) ** 2))\n",
    "    return 1.0 / (1.0 + d)\n",
    "\n",
    "def cosine_similarity(vec1, vec2):\n",
    "    if len(vec1) < 2:\n",
    "        return np.nan\n",
    "    norm1 = np.linalg.norm(vec1)\n",
    "    norm2 = np.linalg.norm(vec2)\n",
    "    if norm1 == 0 or norm2 == 0:\n",
    "        return np.nan\n",
    "    return np.dot(vec1, vec2) / (norm1 * norm2)\n",
    "\n",
    "def pearson_similarity(vec1, vec2):\n",
    "    if len(vec1) < 2:\n",
    "        return np.nan\n",
    "    v1_centered = vec1 - np.mean(vec1)\n",
    "    v2_centered = vec2 - np.mean(vec2)\n",
    "    return cosine_similarity(v1_centered, v2_centered)\n",
    "\n",
    "def precompute_similarity_matrix(matrix, similarity_fn, axis=0):\n",
    "    if axis == 0:\n",
    "        labels = matrix.index       # user IDs\n",
    "    else:\n",
    "        labels = matrix.columns     # movie IDs\n",
    "\n",
    "    sim_df = pd.DataFrame(np.nan, index=labels, columns=labels)\n",
    "\n",
    "    for i, a in enumerate(labels):\n",
    "        for b in labels[i:]:\n",
    "            vec1, vec2 = get_co_rated(matrix, a, b, axis=axis)\n",
    "            score = similarity_fn(vec1, vec2)\n",
    "            sim_df.loc[a, b] = score\n",
    "            sim_df.loc[b, a] = score\n",
    "\n",
    "    return sim_df"
   ]
