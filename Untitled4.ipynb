    "def train_test_split_ratings(ratings_df, test_fraction=0.2):\n",
    "    from scipy.sparse import csr_matrix\n",
    "    user_code = ratings_df['userId'].astype('category').cat.codes\n",
    "    movie_code = ratings_df['movieId'].astype('category').cat.codes\n",
    "    \n",
    "    df = ratings_df.copy()\n",
    "    df['user_code'] = user_code\n",
    "    df['movie_code'] = movie_code\n",
    "    \n",
    "    df = df.sort_values(by=['user_code', 'timestamp']).reset_index(drop=True)\n",
    "    \n",
    "    user_counts = df.groupby('user_code').cumcount()\n",
    "    user_totals = df.groupby('user_code')['user_code'].transform('count')\n",
    "    \n",
    "    test_mask = user_counts >= (user_totals * (1 - test_fraction))\n",
    "    train_mask = ~test_mask\n",
    "    \n",
    "    num_users = df['user_code'].max() + 1\n",
    "    num_movies = df['movie_code'].max() + 1\n",
    "    \n",
    "    train_csr = csr_matrix(\n",
    "        (df.loc[train_mask, 'rating'], (df.loc[train_mask, 'user_code'], df.loc[train_mask, 'movie_code'])),\n",
    "        shape=(num_users, num_movies)\n",
    "    )\n",
    "    \n",
    "    test_csr = csr_matrix(\n",
    "        (df.loc[test_mask, 'rating'], (df.loc[test_mask, 'user_code'], df.loc[test_mask, 'movie_code'])),\n",
    "        shape=(num_users, num_movies)\n",
    "    )\n",
    "    \n",
    "    return train_csr, test_csr\n",
    "    \"\"\"\n",
    "    Splits ratings per-user to guarantee robust testing representations.\n",
    "\n",
    "    Args:\n",
    "        ratings_df (pd.DataFrame): Complete interaction DataFrame\n",
    "        test_fraction (float): Target split proportion\n",
    "    Returns:\n",
    "        tuple(pd.DataFrame, pd.DataFrame): train_df, test_df\n",
    "    \"\"\"\n",
