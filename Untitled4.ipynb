    "   return _find_k_nearest_neighbors(matrix,target_item,k, similarity_fn ,axis = 1, get_co_rated_fn=get_co_rated_fn, sim_cache=sim_cache)\n",
    "\n",
    "def predict_rating_item_based(matrix, target_user, target_item, k, similarity_fn, get_co_rated_fn=None, sim_cache=None):\n",
    "    \"\"\"\n",
    "    Predicts rating for an item by an user based on item similarities.\n",
    "\n",
    "    Args:\n",
    "        matrix (pd.DataFrame): Utility matrix\n",
    "        target_user (int): ID of target user\n",
    "        target_item (int): ID of target movie\n",
    "        k (int): Number of neighbors\n",
    "        similarity_fn (function): Similarity metric\n",
    "    Returns:\n",
    "        float or None: Predicted rating, or None if prediction is unfeasible\n",
    "    \"\"\"\n",
    "    #same as predict user based \n",
    "    if target_user not in matrix.index:\n",
    "            return None # if the target user is not in the matrix, we cannot predict its rating\n",
    "    \n",
    "    neighbors = find_k_nearest_items(matrix ,target_item , k, similarity_fn,get_co_rated_fn=get_co_rated_fn, sim_cache=sim_cache)\n",
    "    num =0.0\n",
    "    denom= 0.0\n",
    "    for neighbor_item, sim_score in neighbors:\n",
    "        rating = matrix.loc[target_user, neighbor_item]\n",
    "        if pd.isna(rating):\n",
    "            continue\n",
    "        num= num + sim_score*rating\n",
    "        denom+= abs(sim_score) \n",
    "    return None if denom == 0.0 else num / denom\n",
    "    "
   ]
