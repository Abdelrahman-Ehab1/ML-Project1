    "def find_k_nearest_users(matrix, target_user, k, similarity_fn, get_co_rated_fn=None, sim_cache=None)-> list[ tuple[int , float]]: \n",
    "\n",
    "    return _find_k_nearest_neighbors(matrix, target_user ,k , similarity_fn , axis =0, get_co_rated_fn=get_co_rated_fn, sim_cache=sim_cache)\n",
    "\n",
    "def predict_rating_user_based(matrix, target_user, target_item, k, similarity_fn, get_co_rated_fn=None, sim_cache=None):\n",
    "    \"\"\"\n",
    "    Predicts rating for an item by an user based on neighbor user ratings.\n",
    "\n",
    "    Args:\n",
    "        matrix (pd.DataFrame): Utility matrix\n",
    "        target_user (int): ID of target user\n",
    "        target_item (int): ID of target movie/item\n",
    "        k (int): Number of neighbors\n",
    "        similarity_fn (function): Similarity metric\n",
    "    Returns:\n",
    "        float or None: Predicted rating, or None if prediction is unfeasible\n",
    "    \"\"\"\n",
    "    #AI generated\n",
    "    if target_item not in matrix.columns:\n",
    "        return None # if the target item is not in the matrix, we cannot predict its rating\n",
    "    #end of generation\n",
    "    neighbors = find_k_nearest_users(matrix ,target_user , k, similarity_fn,get_co_rated_fn=get_co_rated_fn, sim_cache=sim_cache)\n",
    "    num =0.0\n",
    "    denom= 0.0\n",
    "    for neighbor, sim_score in neighbors:\n",
    "        rating = matrix.loc[neighbor, target_item]\n",
    "        if pd.isna(rating):\n",
    "            continue\n",
    "        num= num + sim_score*rating\n",
    "        denom+= abs(sim_score) #AI added abs() to avoid negative weights\n",
    "    return None if denom == 0.0 else num / denom\n"
